# Repository root ignore. The UE project keeps its own Eclipse/.gitignore;
# these entries are belt-and-suspenders so build artifacts never leak in
# from the repo root after the bible+code consolidation.

# OS
.DS_Store
Thumbs.db

# Unreal Engine generated (also ignored by Eclipse/.gitignore)
Eclipse/Binaries/
Eclipse/DerivedDataCache/
Eclipse/Intermediate/
Eclipse/Saved/
Eclipse/Build/

# IDE
Eclipse/.vs/
.vscode/
.idea/
Eclipse/*.sln
Eclipse/*.slnx
Eclipse/.vsconfig

# Python bytecode (Tools/ scripts)
__pycache__/

# Fab direct-download staging (owner drops zips here; never committed raw)
_fab_inbox/

# Fab-library packs: machine-local via Epic Launcher (licensed content, GBs; re-add per machine via 'Add to Project')
Eclipse/Content/SciFi*/
Eclipse/Content/Paragon*/
Eclipse/Content/Fab/

# MetaHuman/Fab character content: machine-local (908 MB+; re-download per machine via Window->Fab)
Eclipse/Content/CharacterAssemblies/
Eclipse/Content/MetaHumans/
Eclipse/Content/Atira_LODSettings/
Eclipse/Content/Locodrome/

# Env-packs uit de curatieronde van 25-07 (samen 5,9 GB). Zelfde regel als de
# packs hierboven: machine-lokaal via de Epic Launcher, nooit in de repo. Ze
# stonden nog untracked, en een enkele 'git add -A' van een volgende sessie zou
# hebben geprobeerd bijna zes gigabyte te committen.
Eclipse/Content/Factory_Pack_V1/
Eclipse/Content/Uniblocks/
Eclipse/Content/Sci_fi_hallway/
Eclipse/Content/IBuilding_49/

Eclipse/Content/FD_WarningSigns_V1/
Eclipse/Content/RustyCarsFree/
Eclipse/Content/Screen_Damage_Indicator/
Eclipse/Content/__ExternalActors__/
Eclipse/Content/__ExternalObjects__/
.claude/scheduled_tasks.lock
